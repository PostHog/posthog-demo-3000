{
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "postCreateCommand": "bash .devcontainer/postCreate.sh",
    "forwardPorts": [5000],
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python"],
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
            }
        }
    }
}
